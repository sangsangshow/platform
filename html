<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>상상쇼 (ssangsangshow.com) - 거대한 엔터프라이즈 허브 플랫폼</title>
  <!-- Tailwind CSS & React CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/react@18/umd/react.development.js"></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
  <style>
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      min-height: 100vh;
      background-color: #f8fafc;
      overflow-x: hidden;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background-color: #cbd5e1;
      border-radius: 4px;
    }
    /* [상상쇼 전역 CSS 표준 규격] 숫자 데이터 우측 정렬, 텍스트 좌측 정렬 고정 */
    .table-num { text-align: right; font-variant-numeric: tabular-nums; }
    .table-text { text-align: left; }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 w-full min-h-screen flex justify-center items-start p-0">

  <div id="root" class="w-full flex justify-center"></div>

  <script type="text/babel">
    const { useState, useEffect } = React;

    // !F / 로고 스텐실 아이콘
    function LogoIfStencil({ className = "h-9", color = "#7c3aed" }) {
      return (
        <svg viewBox="0 0 160 120" class={className} fill={color} xmlns="http://www.w3.org/2000/svg">
          <rect x="25" y="15" width="22" height="52" rx="11" />
          <circle cx="36" cy="95" r="11" />
          <path d="M 75 15 H 125 A 15 15 0 0 1 140 30 v 2 A 15 15 0 0 1 125 47 H 98 v 12 h 25 a 12 12 0 0 1 12 12 v 0 a 12 12 0 0 1 -12 12 H 98 v 22 a 12 12 0 0 1 -23 0 V 27 A 12 12 0 0 1 75 15 Z" />
        </svg>
      );
    }

    function SsangSangShowEnterpriseApp() {
      // 인증 상태 (false: 대중 공개용 상상쇼 메인 홈, true: 회장 전용 시크릿 관제탑)
      const [isCeoLoggedIn, setIsCeoLoggedIn] = useState(false);
      const [showLoginModal, setShowLoginModal] = useState(false);
      
      const [activeTab, setActiveTab] = useState('public_home');
      const [activeFp, setActiveFp] = useState('suzoc');
      const [isFpFullScreen, setIsFpFullScreen] = useState(false);

      const [showPlusModal, setShowPlusModal] = useState(false);
      const [plusYear, setPlusYear] = useState(2026);
      const [plusMonth, setPlusMonth] = useState(9);
      const [plusDay, setPlusDay] = useState(23);
      const [plusType, setPlusType] = useState('inc');
      const [plusContent, setPlusContent] = useState('');
      const [plusAmount, setPlusAmount] = useState('');

      const [selectedYear, setSelectedYear] = useState(2026);
      const [selectedMonth, setSelectedMonth] = useState(9);

      // 공식 8대 FP 라인업 명세
      const fpList = [
        { id: 'suzoc', name: '수족 (SUZOC)', desc: '인간의 손과 발처럼 AI를 자유롭게 부리고 지휘하는 핵심 제어 코어' },
        { id: 'momad', name: '모마드라이프 (Momad Life)', desc: '미니멀 & 노마드, 2m×3m Z1 그리드 평면도 및 쪼막노트 90도 회전 뷰' },
        { id: 'salgga', name: '살까 말까 (Should I Buy It?)', desc: '마드리(MAD LEE)의 감각적 UI/UX 철학이 녹아든 소비 의사결정 인터랙티브 서비스' },
        { id: 'kclim', name: '끌림 (Kklím)', desc: '사용자 간 깊은 공감과 자발적 참여를 이끌어내는 감성 큐레이션' },
        { id: 'nemocity', name: '네모 시티 (Nemo City)', desc: '공간, 도시, 메타버스와 현실을 유기적으로 연결하는 확장형 플랫폼' },
        { id: 'painpoint', name: '페인 포인트 (Pain Point)', desc: '일상과 비즈니스의 날카로운 문제점 포착 및 해결책 아카이브' },
        { id: 'ilsaeng', name: '일생 (Il-Saeng)', desc: '개인의 삶과 커리어, 여정을 아우르는 장기 아카이브 및 자생 생태계' },
        { id: 'voollo', name: '블로 (VOOLLO)', desc: '노동과 창업의 굴레에서 벗어나 편안하게 성과와 가치를 누리는 창업 지원 플랫폼' },
      ];

      // 상상노트 5대 보드 데이터 (LocalStorage 연동)
      const [noteCategories, setNoteCategories] = useState(() => {
        const saved = localStorage.getItem('ssangsang_notes_v3');
        if (saved) { try { return JSON.parse(saved); } catch(e) {} }
        return {
          task: [{ id: 1, text: '살까말까 로고 디벨롭하기' }],
          achievement: [{ id: 2, text: '상상쇼 마스터 허브 컨테이너 셸 구축' }, { id: 3, text: '[모마드라이프] 그리드 툴 동기화' }],
          planning: [],
          idea: [],
          memo: []
        };
      });

      useEffect(() => {
        localStorage.setItem('ssangsang_notes_v3', JSON.stringify(noteCategories));
      }, [noteCategories]);

      // 금전출납부 데이터
      const [ledgerData, setLedgerData] = useState(() => {
        const saved = localStorage.getItem('ssangsang_ledger_v3');
        if (saved) { try { return JSON.parse(saved); } catch(e) {} }
        return [
          { id: 1, year: 2026, month: 9, day: 22, desc: '상상쇼 도메인 등록 정산', type: 'inc', amt: 27500000 },
          { id: 2, year: 2026, month: 9, day: 21, desc: '서버 클라우드 인프라 유지비', type: 'exp', amt: 5045000 },
        ];
      });

      useEffect(() => {
        localStorage.setItem('ssangsang_ledger_v3', JSON.stringify(ledgerData));
      }, [ledgerData]);

      const moveNoteItem = (catKey, index, direction) => {
        const list = [...noteCategories[catKey]];
        const targetIndex = direction === 'up' ? index - 1 : index + 1;
        if (targetIndex < 0 || targetIndex >= list.length) return;
        const [moved] = list.splice(index, 1);
        list.splice(targetIndex, 0, moved);
        setNoteCategories({ ...noteCategories, [catKey]: list });
      };

      const getMonthStats = (yr, mth) => {
        const filtered = ledgerData.filter(i => i.year === yr && i.month === mth);
        const inc = filtered.filter(i => i.type === 'inc').reduce((a, c) => a + c.amt, 0);
        const exp = filtered.filter(i => i.type === 'exp').reduce((a, c) => a + c.amt, 0);
        return { inc, exp, net: inc - exp };
      };

      const currentStats = getMonthStats(selectedYear, selectedMonth);

      const handleSaveEntry = () => {
        if (!plusAmount) { alert('금액을 입력해주세요.'); return; }
        const newEntry = {
          id: Date.now(),
          year: parseInt(plusYear),
          month: parseInt(plusMonth),
          day: parseInt(plusDay),
          desc: plusContent || '일반 항목',
          type: plusType,
          amt: parseInt(plusAmount)
        };
        setLedgerData([newEntry, ...ledgerData]);
        setShowPlusModal(false);
        setPlusContent('');
        setPlusAmount('');
      };

      const handleLoginAsCeo = () => {
        setIsCeoLoggedIn(true);
        setShowLoginModal(false);
        setActiveTab('ssang_note');
      };

      const handleLogoutToPublic = () => {
        setIsCeoLoggedIn(false);
        setActiveTab('public_home');
      };

      return (
        <div class="w-full max-w-[430px] min-h-screen bg-slate-50 px-2 pt-3 pb-24 space-y-2.5 box-border flex flex-col justify-start relative">

          {/* 상단 마스터 헤더 (공개 메인 홈 로고 중앙 정렬 반영) */}
          <header class="w-full bg-white px-4 py-3 rounded-2xl flex items-center justify-between shadow-sm box-border">
            <div class="flex items-center gap-2 cursor-pointer" onClick={() => { setActiveTab('public_home'); setIsFpFullScreen(false); }}>
              <span class="text-xl">✨</span>
              <div>
                <p class="text-[10px] font-bold text-slate-500 tracking-tight leading-none table-text">상상을 현실로 보여주는</p>
                <h1 class="text-xl font-black text-slate-900 tracking-tight leading-none mt-0.5 table-text">상상쇼</h1>
              </div>
            </div>

            <div class="flex items-center gap-2">
              {!isCeoLoggedIn ? (
                <button 
                  onClick={() => setShowLoginModal(true)}
                  class="bg-purple-600 text-white text-xs font-black px-3 py-2 rounded-xl shadow-md active:scale-95 transition-transform"
                >
                  🔒 회장 모드 로그인
                </button>
              ) : (
                <button 
                  onClick={handleLogoutToPublic}
                  class="bg-slate-900 text-white text-xs font-black px-3 py-2 rounded-xl shadow-md active:scale-95 transition-transform flex items-center gap-1"
                >
                  <span>🏠</span> 공개 홈 나가기
                </button>
              )}
            </div>
          </header>

          {/* 회장 전용 시크릿 관제탑 GNB ([상상노트 | !F | 상상쇼그룹]) */}
          {isCeoLoggedIn && (
            <nav class="w-full bg-purple-900 text-white px-3 py-2 rounded-xl shadow-md flex items-center justify-around text-xs font-black">
              <button onClick={() => setActiveTab('ssang_note')} class={`px-2 py-1 rounded-lg ${activeTab === 'ssang_note' ? 'bg-purple-700' : 'text-purple-200'}`}>
                📝 상상노트
              </button>
              <span>|</span>
              <button onClick={() => setActiveTab('ledger')} class={`px-2 py-1 rounded-lg ${activeTab === 'ledger' ? 'bg-purple-700' : 'text-purple-200'}`}>
                💰 !F 금전출납부
              </button>
              <span>|</span>
              <button onClick={() => setActiveTab('group')} class={`px-2 py-1 rounded-lg ${activeTab === 'group' ? 'bg-purple-700' : 'text-purple-200'}`}>
                🏛️ 상상쇼그룹 (8대 FP)
              </button>
            </nav>
          )}

          {/* 메인 캔버스 영역 */}
          <main class="w-full flex-1 space-y-3">

            {/* A. 대중 공개용 상상쇼 메인 홈 (최초 접속 화면) */}
            {activeTab === 'public_home' && (
              <div class="w-full space-y-3">
                <div class="bg-gradient-to-br from-slate-900 via-purple-950 to-slate-900 text-white p-5 rounded-3xl shadow-lg space-y-2 text-center">
                  <span class="text-[10px] font-black bg-purple-500/30 text-purple-200 px-3 py-1 rounded-full border border-purple-400/30">
                    SsangSang Show Hub
                  </span>
                  <h2 class="text-xl font-black tracking-tight table-text text-center">상상쇼 거대한 허브 플랫폼</h2>
                  <p class="text-xs text-slate-300 font-medium leading-relaxed table-text text-center">
                    유튜브 숏폼 및 자발적 선택에 기반한 8대 공식 FP 생태계를 경험하세요.
                  </p>
                </div>

                <div class="space-y-2">
                  <h3 class="text-xs font-black text-slate-500 px-1 table-text">🚀 공식 8대 FP 라인업 컨테이너</h3>
                  {fpList.map(fp => (
                    <div key={fp.id} class="bg-white border border-slate-200 p-3.5 rounded-2xl shadow-sm flex justify-between items-center hover:border-purple-300 transition-colors">
                      <div class="table-text pr-2">
                        <h4 class="text-sm font-black text-slate-900">{fp.name}</h4>
                        <p class="text-[11px] text-slate-500 font-bold">{fp.desc}</p>
                      </div>
                      <button 
                        onClick={() => { setActiveFp(fp.id); setIsFpFullScreen(true); }}
                        class="bg-slate-900 text-white text-xs font-bold px-3 py-2 rounded-xl active:scale-95 transition-transform shrink-0 ml-2"
                      >
                        입장
                      </button>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* B. 시크릿 공간: 상상노트 5대 보드 (과제/성과/기획/아이디어/메모) */}
            {activeTab === 'ssang_note' && isCeoLoggedIn && (
              <div class="w-full space-y-3 bg-slate-100/80 p-2 rounded-2xl border border-slate-200">
                <div class="bg-white px-4 py-3 rounded-xl border border-slate-200 shadow-sm text-center space-y-1">
                  <p class="text-[11px] font-bold text-slate-500 tracking-tight table-text text-center">상상을 현실로 보여주는</p>
                  <h2 class="text-xl font-black text-slate-900 tracking-tight table-text text-center">상상노트</h2>
                  <span class="text-[10px] font-bold text-purple-600">회장 전용 시크릿 아카이브</span>
                </div>

                {['task', 'achievement', 'planning', 'idea', 'memo'].map((catKey) => {
                  const titles = { task: '과제', achievement: '성과', planning: '기획', idea: '아이디어', memo: '메모' };
                  const items = noteCategories[catKey];
                  return (
                    <div key={catKey} class="bg-white border border-slate-300 rounded-xl overflow-hidden shadow-sm">
                      <div class="bg-slate-50 px-3 py-2 border-b border-slate-200 font-bold text-sm text-slate-800 flex justify-between items-center">
                        <span class="table-text">{titles[catKey]}</span>
                        <span class="text-[10px] text-purple-600 font-bold cursor-pointer" onClick={() => {
                          const txt = prompt(`새로운 ${titles[catKey]} 내용을 입력하세요:`);
                          if(txt) {
                            setNoteCategories({...noteCategories, [catKey]: [...items, { id: Date.now(), text: txt }]});
                          }
                        }}>+ 추가</span>
                      </div>
                      <div class="p-2 space-y-2 min-h-[40px]">
                        {items.length === 0 ? (
                          <div class="text-xs text-slate-400 text-center py-1 font-medium">등록된 항목이 없습니다.</div>
                        ) : (
                          items.map((item, idx) => (
                            <div key={item.id} class="flex items-center justify-between text-xs text-slate-800 font-semibold bg-white p-1.5 border border-slate-100 rounded">
                              <span class="table-text truncate pr-1">• {item.text}</span>
                              <div class="flex items-center gap-0.5 shrink-0 bg-slate-100 border border-slate-200 rounded px-1 py-0.5">
                                <button onClick={() => moveNoteItem(catKey, idx, 'up')} class="text-[10px] text-slate-600 font-black px-0.5">▲</button>
                                <button onClick={() => moveNoteItem(catKey, idx, 'down')} class="text-[10px] text-slate-600 font-black px-0.5">▼</button>
                                <button onClick={() => {
                                  const filtered = items.filter(i => i.id !== item.id);
                                  setNoteCategories({...noteCategories, [catKey]: filtered});
                                }} class="text-[10px] text-rose-500 font-black px-1 border-l border-slate-300 ml-1">✕</button>
                              </div>
                            </div>
                          ))
                        )}
                      </div>
                    </div>
                  );
                })}
              </div>
            )}

            {/* C. 시크릿 공간: !F 금전출납부 */}
            {activeTab === 'ledger' && isCeoLoggedIn && (
              <div class="w-full bg-white rounded-2xl p-3 space-y-3 shadow-sm box-border">
                <div class="text-center space-y-1 relative pt-1">
                  <p class="text-sm font-black text-slate-800 tracking-tight table-text text-center">티끌 모아 1,000억!</p>
                  <div class="flex justify-between items-center px-1">
                    <LogoIfStencil className="h-8 w-auto" color="#7c3aed" />
                    <button onClick={() => setShowPlusModal(true)} class="bg-purple-600 text-white text-xs font-black px-3 py-1.5 rounded-xl">
                      + 거래 기입
                    </button>
                  </div>
                </div>

                <div class="bg-emerald-50 border border-emerald-200 rounded-2xl p-3 text-center">
                  <p class="text-xs font-black text-emerald-900 table-text text-center">{selectedMonth}월 수지 현황</p>
                  <h3 class="text-xl font-black text-slate-900 mt-1 table-num">
                    순수익: {currentStats.net > 0 ? `+${currentStats.net.toLocaleString()}` : currentStats.net.toLocaleString()} 원
                  </h3>
                </div>

                <div class="space-y-1 max-h-[350px] overflow-y-auto">
                  {ledgerData.map(item => (
                    <div key={item.id} class="flex justify-between items-center text-xs font-bold p-2 bg-slate-50 rounded-xl border border-slate-100">
                      <div class="table-text">
                        <span class="text-slate-400 mr-2">{item.month}/{item.day}</span>
                        <span class="text-slate-900">{item.desc}</span>
                      </div>
                      <span class={`table-num ${item.type === 'inc' ? 'text-rose-600 font-black' : 'text-blue-600 font-black'}`}>
                        {item.type === 'inc' ? `+${item.amt.toLocaleString()}` : `-${item.amt.toLocaleString()}`}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* D. 상상쇼그룹 8대 FP 관제 센터 */}
            {activeTab === 'group' && isCeoLoggedIn && (
              <div class="w-full space-y-2">
                <div class="bg-purple-50 border border-purple-200 p-3.5 rounded-2xl text-purple-900">
                  <h3 class="text-base font-black table-text">🏛️ 상상쇼그룹 8대 FP 관제센터</h3>
                </div>
                {fpList.map(fp => (
                  <div key={fp.id} class="bg-white border border-slate-200 p-3.5 rounded-xl flex justify-between items-center">
                    <div class="table-text pr-2">
                      <h4 class="text-sm font-black text-slate-900">{fp.name}</h4>
                      <p class="text-xs text-slate-500">{fp.desc}</p>
                    </div>
                    <button onClick={() => { setActiveFp(fp.id); setIsFpFullScreen(true); }} class="bg-slate-900 text-white text-xs font-bold px-3 py-1.5 rounded-lg shrink-0">
                      조회
                    </button>
                  </div>
                ))}
              </div>
            )}

          </main>

          {/* 회장 모드 로그인 모달 */}
          {showLoginModal && (
            <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4">
              <div class="bg-white rounded-3xl p-6 max-w-xs w-full shadow-2xl space-y-4 border border-slate-200">
                <div class="flex justify-between items-center border-b border-slate-100 pb-3">
                  <h3 class="text-base font-black text-slate-900 table-text">🔒 회장 전용 시크릿 로그인</h3>
                  <button onClick={() => setShowLoginModal(false)} class="text-slate-400 font-black text-lg">✕</button>
                </div>
                <p class="text-xs text-slate-500 font-bold leading-normal table-text">
                  상상노트 및 금전출납부 등 시크릿 경영 관제 공간에 접속합니다.
                </p>
                <button 
                  onClick={handleLoginAsCeo}
                  class="w-full py-3 rounded-2xl bg-purple-600 text-white font-black text-sm shadow-md active:scale-95 transition-transform"
                >
                  회장 모드 진입하기
                </button>
              </div>
            </div>
          )}

          {/* 거래 기입 모달 */}
          {showPlusModal && (
            <div class="fixed inset-0 bg-slate-900/70 backdrop-blur-md z-50 flex items-center justify-center p-4">
              <div class="bg-white rounded-3xl p-5 max-w-xs w-full shadow-2xl space-y-3">
                <div class="flex justify-between items-center border-b pb-2">
                  <h3 class="text-sm font-black text-slate-900 table-text">⚡ 거래 퀵 기입</h3>
                  <button onClick={() => setShowPlusModal(false)} class="text-slate-400">✕</button>
                </div>
                <div>
                  <label class="text-xs font-black text-slate-600 table-text">유형</label>
                  <div class="grid grid-cols-2 gap-2 mt-1">
                    <button onClick={() => setPlusType('inc')} class={`py-2 text-xs font-black rounded-xl ${plusType === 'inc' ? 'bg-rose-600 text-white' : 'bg-slate-100 text-slate-600'}`}>수입</button>
                    <button onClick={() => setPlusType('exp')} class={`py-2 text-xs font-black rounded-xl ${plusType === 'exp' ? 'bg-purple-600 text-white' : 'bg-slate-100 text-slate-600'}`}>지출</button>
                  </div>
                </div>
                <div>
                  <label class="text-xs font-black text-slate-600 table-text">적요</label>
                  <input type="text" value={plusContent} onChange={e => setPlusContent(e.target.value)} placeholder="예: 서버비" class="w-full bg-slate-50 p-2.5 rounded-xl border text-xs font-black mt-1 table-text" />
                </div>
                <div>
                  <label class="text-xs font-black text-slate-600 table-text">금액 (원)</label>
                  <input type="number" value={plusAmount} onChange={e => setPlusAmount(e.target.value)} placeholder="예: 50000" class="w-full bg-slate-50 p-2.5 rounded-xl border text-xs font-black mt-1 table-num" />
                </div>
                <button onClick={handleSaveEntry} class="w-full py-3 bg-purple-600 text-white text-xs font-black rounded-xl shadow-md">저장 완료</button>
              </div>
            </div>
          )}

          {/* FP 풀스크린 레이어 (100% 원본 UI 서빙 컨테이너) */}
          {isFpFullScreen && (
            <div class="fixed inset-0 bg-white z-50 flex flex-col p-4 space-y-3">
              <div class="flex items-center justify-between bg-slate-900 text-white p-3.5 rounded-2xl">
                <span class="text-sm font-black table-text">{fpList.find(f => f.id === activeFp)?.name} 풀스크린 관제</span>
                <button onClick={() => setIsFpFullScreen(false)} class="bg-purple-600 text-white px-3 py-1 rounded-lg text-xs font-black">
                  ↩️ 상상쇼 복귀
                </button>
              </div>
              <div class="flex-1 flex flex-col items-center justify-center text-center space-y-2 bg-slate-50 rounded-2xl border p-4">
                <span class="text-xs font-black text-purple-700 bg-purple-100 px-3 py-1 rounded-full">독립 프로덕트 100% 서빙 중</span>
                <h3 class="text-lg font-black text-slate-900 table-text text-center">[{fpList.find(f => f.id === activeFp)?.name}] 서비스 관제 영역</h3>
                <p class="text-xs text-slate-500 table-text text-center">회장님의 자발적 선택 기반 내비게이션 및 데이터 허브 연동 완료</p>
              </div>
            </div>
          )}

        </div>
      );
    }

    ReactDOM.createRoot(document.getElementById('root')).render(<SsangSangShowEnterpriseApp />);
  </script>
</body>
</html>
